{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JnWorkerStream",
  "version": "0.1.0",
  "identifier": "com.jnws.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../apps/desktop dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir ../apps/desktop build",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JnWorkerStream",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
